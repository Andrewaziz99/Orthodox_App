# Orthodox App - Web Environment Variables
# Copy this file to .env.local and update as needed

# Graphy owns auth, users, churches, educational curricula, and Bible data.
NEXT_PUBLIC_GRAPHY_API_URL=http://localhost:3000/api/v1

# CMS owns website content, news, videos, uploads, and curriculum presentation metadata.
NEXT_PUBLIC_CMS_API_URL=http://localhost:3005

# Used for canonical metadata, robots, and sitemap URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
